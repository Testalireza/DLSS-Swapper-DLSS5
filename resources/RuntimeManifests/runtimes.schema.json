{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DLSS Swapper 5 runtime manifest",
  "type": "object",
  "required": ["schemaVersion", "runtimes"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "generated": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "fileCatalog": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "role": { "type": "string" },
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "files"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string", "pattern": "^\\d+(\\.\\d+)*$" },
          "dlssVersion": { "type": ["string", "null"] },
          "streamlineVersion": { "type": ["string", "null"] },
          "channel": { "type": "string", "enum": ["stable", "beta", "legacy"] },
          "minimumDriver": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "role": { "type": "string" },
                "required": { "type": "boolean", "default": false },
                "sha256": { "type": ["string", "null"] },
                "sizeBytes": { "type": ["integer", "null"] },
                "detectedVersion": { "type": ["string", "null"] }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": { "type": "string" },
                "url": { "type": "string" },
                "notes": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
